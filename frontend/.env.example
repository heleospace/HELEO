# Contract addresses per network (fill in after deploying from the /deploy page)
VITE_LEO_ADDRESS_MAINNET=
VITE_STAKING_ADDRESS_MAINNET=
VITE_LEO_ADDRESS_SEPOLIA=
VITE_STAKING_ADDRESS_SEPOLIA=

# Optional dedicated RPC endpoints (Alchemy / Infura / QuickNode ...).
# Leave blank to use viem's default public endpoint.
VITE_RPC_URL_MAINNET=
VITE_RPC_URL_SEPOLIA=

# Wallet allowed to see the /deploy page
VITE_DEPLOYER_WALLET=

# Reown / WalletConnect project ID — create your own at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=

# LayerZero bridge (Sepolia <-> Base Sepolia testnet)
VITE_LZ_ENDPOINT_SEPOLIA=
VITE_LZ_ENDPOINT_BASE_SEPOLIA=
VITE_OFT_ADAPTER_ADDRESS=
VITE_OFT_BASE_SEPOLIA_ADDRESS=

# Path the site is served from. "/" for the domain root, "/token/" for
# https://heleo.space/token (must start and end with "/").
VITE_BASE_PATH=/
