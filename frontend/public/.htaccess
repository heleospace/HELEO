# Single-page app fallback: serve index.html for any request that isn't a
# real file or directory, so React Router can handle client-side routes
# (e.g. /token/whitepaper, /token/security) on direct load and page refresh.
# No RewriteBase: rules resolve relative to the folder this file is in, so
# the same file works at the domain root or in a subfolder like /token.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
